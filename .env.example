# ---------------------------------------------------------------------------
# SYNDICATE Achievements — environment variables
# Copy this file to ".env" for local development, and set the same values in
# the Vercel project (Settings → Environment Variables) for production.
# Never commit a filled-in .env. Never share these values in chat or tickets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon: Dashboard → Connection Details).
# Use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct (unpooled) PostgreSQL connection string — used by Prisma only for
# migrations (`prisma migrate deploy`), which must not run through a pooler.
# Neon: same Connection Details panel, uncheck "Pooled connection" (port 5432).
# Supabase: pooled uses port 6543 with ?pgbouncer=true; direct uses port 5432.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js session signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Required when running `next start` locally or on any non-Vercel host —
# tells Auth.js to trust the incoming host header. On Vercel this is
# handled automatically and can be left unset.
AUTH_TRUST_HOST="true"

# The single admin account. There is no registration — this IS the account.
ADMIN_USERNAME=""

# bcrypt hash of the admin password (the plaintext is never stored).
# Generate with:  npm run hash-password   (it prints both forms below)
#
# IMPORTANT — the "$" problem: bcrypt hashes look like $2a$12$... and .env
# loaders expand "$..." as variable references, destroying the hash.
# - Local .env: use the ESCAPED form (every $ written as \$), exactly as the
#   hash script prints it for local use:
#     ADMIN_PASSWORD_HASH="\$2a\$12\$..."
# - Vercel dashboard: paste the RAW hash with NO backslashes — Vercel does
#   no expansion. (The app also unescapes defensively, but raw is correct.)
ADMIN_PASSWORD_HASH=""

# Vercel Blob read-write token (Vercel project → Storage → your Blob store
# → .env.local tab, or the store's Settings). Needed for screenshot uploads
# from the admin panel; without it, the panel falls back to pasted URLs.
BLOB_READ_WRITE_TOKEN=""

# Sentry error tracking (project "syndicate-achievements", org
# "codeiwithkrrish"). Optional: when unset, the app falls back to the public
# DSN constant in lib/sentry-dsn.ts. A DSN is a public ingestion key — it can
# only send error events to the project, never read them.
NEXT_PUBLIC_SENTRY_DSN=""
